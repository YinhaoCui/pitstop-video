<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Background playback: media notification + foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Downloads keep running in the background, with a progress notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Settings → Check for updates: installs a newer APK from the app's GitHub releases (user confirms) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Offline videos stored on the phone -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Songs stored on the phone (e.g. downloaded from Google Drive) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Parked-only safety lock: phone GPS speed is the fallback when the car does not report speed -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_SPEED" />
    <!-- Android Auto: draw our own content (the video) on the map surface. Flavor "parked": a
         point-of-interest app (MAP_TEMPLATES); flavor "nav": a navigation app (NAVIGATION_TEMPLATES),
         which Android Auto only shows when the Play Store is recorded as the installer. -->
    <uses-permission android:name="androidx.car.app.${carPermission}" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <!-- One APK for phones, tablets, Android Automotive OS cars and aftermarket head units. -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:name=".PitstopApp"
        android:appCategory="${appCategory}"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pitstop">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="7" />

        <activity
            android:name=".ui.MainActivity"
            android:theme="@style/Theme.Pitstop.Starting"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android Auto parked app (flavor "parked"; the "nav" flavor gives it a dummy category): this
             activity is shown on the car screen while parked. It works however the APK was installed:
             the Car App Library service below is refused on real cars ("failed all other checks") unless
             the Play Store is recorded as the installer. Parked apps need a category Android Auto has enabled; "video" is not yet ("Not allowed
             native app"), so the app is declared a game. It is a second activity with its own task, so
             the phone app can be open at the same time and act as a remote. -->
        <activity
            android:name=".ui.CarDisplayActivity"
            android:theme="@style/Theme.Pitstop.Starting"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.car"
            android:excludeFromRecents="true"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="${parkedCategory}" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.BiliLoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.NeteaseLoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.YouTubeLoginActivity"
            android:exported="false" />

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
        <!-- Shizuku hands its service to the app through this provider (Mirror Video's on-phone update). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <service
            android:name=".car.VideoCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <!-- POI (parked flavor) or NAVIGATION (nav flavor): the map surface is where the video is drawn. -->
                <category android:name="androidx.car.app.category.${carCategory}" />
            </intent-filter>
        </service>
    </application>
</manifest>
